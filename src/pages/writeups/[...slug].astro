---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writeups', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, summary, category, tags } = post.data;
const day = date.toISOString().slice(0, 10);
---

<Base title={title} description={summary}>
  <div class="wrap">
    <header class="article-head">
      <a class="back" href="/writeups/">← all writeups</a>
      <h1>{title}</h1>
      <div class="post-meta">
        <span>{day}</span>
        <span>{category}</span>
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((t) => (
              <span class="tag">#{t}</span>
            ))}
          </div>
        )
      }
    </header>

    <article class="prose">
      <Content />
    </article>
  </div>
</Base>
