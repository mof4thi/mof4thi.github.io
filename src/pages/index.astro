---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writeups', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const focus = [
  {
    title: 'Blue team and SOC',
    text: 'Alert triage, detection, and incident handling, learned in a SOC apprenticeship.',
  },
  {
    title: 'Offensive security',
    text: 'Methodical pentesting practice, currently working toward the HTB CPTS.',
  },
  {
    title: 'Security and AI',
    text: 'The overlap I studied in my MSc: using ML to defend, and securing ML systems.',
  },
];
---

<Base>
  <div class="wrap">
    <section class="hero">
      <h1>Mohammed Fathi<span class="caret" aria-hidden="true"></span></h1>
      <p class="lead">
        Cybersecurity professional based in Paris.<br><br><strong>MSc Cybersecurity and AI </strong> (EFREI PARIS)
        <br> I write up what I learn: labs, investigations, and the occasional mistake.
      </p>
      <div class="actions">
        <a class="btn primary" href="/writeups/">Read writeups</a>
        <a class="btn" href="/about/">About me</a>
        <a class="btn" href="/contact/">Get in touch</a>
      </div>
    </section>


    <section class="section">
      <div class="section-head">
        <h2>Latest writeups</h2>
        <a class="mono" href="/writeups/">all posts →</a>
      </div>
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</Base>
