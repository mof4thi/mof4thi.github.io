---
import Base from '../layouts/Base.astro';

// EDIT ME: replace these placeholder entries with your real projects.
// status: 'live' shows an accent-colored badge, anything else shows a muted one.
const projects = [
  {
    name: 'Project name',
    status: 'in progress',
    text: 'One or two sentences: what it does, why you built it, and what you learned.',
    stack: ['python', 'linux'],
    href: 'https://github.com/mof4thi',
  },
  {
    name: 'Another project',
    status: 'live',
    text: 'Home lab, detection rules, a tool, a CTF solver. Anything you are proud of works here.',
    stack: ['sigma', 'elastic'],
    href: 'https://github.com/mof4thi',
  },
];
---

<Base title="Projects" description="Security projects, tools and lab builds by Mohammed Fathi.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Things I've built</h1>
      <p>Tools, labs, and experiments.</p>
    </header>

    <div class="cards">
      {
        projects.map((p) => (
          <a class="card" href={p.href}>
            <div class="card-top">
              <h3>{p.name}</h3>
              <span class={p.status === 'live' ? 'status live' : 'status'}>{p.status}</span>
            </div>
            <p>{p.text}</p>
            <div class="tags">
              {p.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
