---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Mohammed Fathi';
const {
  title,
  description = 'Cybersecurity notes, writeups and projects by Mohammed Fathi.',
} = Astro.props;

const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · Cybersecurity`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site); // ADDED
const path = Astro.url.pathname;
const year = new Date().getFullYear();

const nav = [
  { href: '/writeups/', label: 'writeups' },
//  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: '/contact/', label: 'contact' },
];
const isActive = (href: string) => path.startsWith(href);
---

<!doctype html>
<html lang="en" data-theme="ocean">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} writeups`} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} /> <!-- ADDED -->
    <meta property="og:image:width" content="1200" /> <!-- ADDED -->
    <meta property="og:image:height" content="627" /> <!-- ADDED -->
    <meta name="twitter:card" content="summary_large_image" /> <!-- ADDED -->
    <meta name="generator" content={Astro.generator} />

    <!-- Apply the saved theme before first paint to avoid a flash. -->
    <script is:inline>
      try {
        var allowed = [ 'ocean', 'terminal', 'daylight'];
        var saved = localStorage.getItem('theme');
        if (saved && allowed.indexOf(saved) !== -1) {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
<a class="brand" href="/">
  <svg class="brand-logo" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
    <rect x="1" y="1" width="62" height="62" rx="14" stroke-width="2" style="fill: var(--surface); stroke: var(--border)" />
    <path d="M14 46V18l18 20 18-20v28" fill="none" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--accent)" />
  </svg>
  Home
</a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <ThemeSwitcher />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {year}</span>
        <span class="footer-links">
          <a href="https://github.com/mof4thi">GitHub</a>
          <a href="https://www.linkedin.com/in/mohammed-fathi-44325221a">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
