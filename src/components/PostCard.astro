---
import type { Article } from '../lib/content';
import { readingTime } from '../lib/reading-time';
import { localize, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  post: Article;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { title, date, summary, category, tags, draft } = post.data;
const day = date.toISOString().slice(0, 10);
const minutes = readingTime(post.body);
---

<li class="post">
  <div class="post-meta">
    <span>{day}</span>
    <span>{category}</span>
    <span>{minutes} {t('article.minutes')}</span>
    {draft && <span>({t('article.draft')})</span>}
  </div>
  <div>
    <h3><a href={localize(lang, `/articles/${post.id}/`)}>{title}</a></h3>
    <p>{summary}</p>
    {tags.length > 0 && <div class="tags">{tags.join(', ')}</div>}
  </div>
</li>
