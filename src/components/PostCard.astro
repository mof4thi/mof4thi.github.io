---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writeups'>;
}

const { post } = Astro.props;
const { title, date, summary, category, tags, draft } = post.data;
const day = date.toISOString().slice(0, 10);
---

<a class="post" href={`/writeups/${post.id}/`}>
  <div class="post-meta">
    <span>{day}{draft ? ' · draft' : ''}</span>
    <span>{category}</span>
  </div>
  <h3>{title}</h3>
  <p>{summary}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <span class="tag">#{t}</span>
        ))}
      </div>
    )
  }
</a>
